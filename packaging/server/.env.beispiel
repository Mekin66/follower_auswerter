# Kopieren nach packaging/server/.env und ausfüllen
SECRET_KEY=hier-einen-langen-zufallswert-eintragen
ACCOUNTS_AKTIVIERT=0
REGISTRIERUNG_OFFEN=1
AUTO_CHECK_AKTIVIERT=0
COOKIES_NUR_HTTPS=1
ANONYM_AUFBEWAHRUNG_STUNDEN=24
BETREIBER_NAME=
BETREIBER_ADRESSE=
BETREIBER_EMAIL=
HOSTER_NAME=Hetzner Online GmbH, Gunzenhausen
HOSTER_SITZ=Deutschland
AUFSICHTSBEHOERDE=
# aus | hinweis | einwilligung  (einwilligung nur nötig, wenn optionale Dienste eingebunden sind)
COOKIE_BANNER=aus
# Konten ohne Anmeldung seit so vielen Tagen werden gelöscht (0 = nie)
KONTO_LOESCHEN_NACH_TAGEN=365

# ---------- E-Mail (nur wichtig, wenn ACCOUNTS_AKTIVIERT=1) ----------
# Öffentliche Adresse der Seite (für die Links in den Mails)
OEFFENTLICHE_URL=https://follower.example.de
E_MAIL_PFLICHT=1
E_MAIL_BESTAETIGUNG=1
BESTAETIGUNG_GUELTIG_STUNDEN=48
# Freiwilliges Häkchen "Neuigkeiten per E-Mail" bei der Registrierung
NEWSLETTER_ABFRAGEN=0
# Postausgangsserver – Daten vom Mail-Anbieter. Leer = Testmodus (Mails nur im Log)
# Beispiel Strato: smtp.strato.de, Port 465, ssl  |  IONOS: smtp.ionos.de, 587, starttls
SMTP_HOST=
SMTP_PORT=587
SMTP_VERSCHLUESSELUNG=starttls
SMTP_BENUTZER=
SMTP_PASSWORT=
SMTP_ABSENDER=Follower-Auswertung <noreply@example.de>
